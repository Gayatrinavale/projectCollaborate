<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Staff Dashboard</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <style>
    body {
      margin: 0;
      font-family: 'Arial', sans-serif;
      display: flex;
      height: 100vh;
      background: radial-gradient(circle, #e0f7fa, hsl(195, 18%, 96%));
    }

    .sidebar {
      width: 260px;
      background-color: hwb(180 6% 93%);
      color: #f7f3f3;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-top: 20px;
      position: fixed;
      height: 100%;
      overflow-y: auto;
    }

    .sidebar img {
      height: 180px;
      width: 220px;
      border-radius: 8px;
      object-fit: cover;
      margin-bottom: 30px;
      border: none;
    }

    .menu {
      width: 100%;
      display: flex;
      flex-direction: column;
    }

    .menu a {
      display: flex;
      align-items: center;
      padding: 14px 24px;
      color: #fdf7f7;
      text-decoration: none;
      font-weight: 700;
      font-size: 20px;
      cursor: pointer;
      transition: background-color 0.3s, transform 0.2s;
    }

    .menu a i {
      margin-right: 14px;
      font-size: 1.7em;
      color: rgb(245, 241, 241);
    }

    .menu a:hover {
      background-color: #d3d3d3;
      transform: translateX(2px);
    }

    .content {
      margin-left: 250px;
      padding: 40px;
      width: calc(100% - 250px);
      background: radial-gradient(circle, #fef2f2, #fbc0c0);
      border-radius: 10px;
    }

    .content h2 {
      font-size: 32px;
      font-weight: bold;
    }

    .content p {
      font-size: 20px;
    }

    @media(max-width: 768px) {
      .sidebar {
        width: 200px;
      }

      .content {
        margin-left: 200px;
        width: calc(100% - 200px);
      }
    }
  </style>
</head>
<body>

  <div class="sidebar">
    <img src="images/dash.png" alt="Logo" />
    <div class="menu">
      <a href="#"><i class="fas fa-tachometer-alt"></i>Dashboard</a>
      <a href="#"><i class="fas fa-chair"></i>Dining Tables</a>
      <a href="#"><i class="fas fa-eye"></i>View Orders</a>
      <a href="#"><i class="fas fa-chart-line"></i>Reports</a>
    </div>
  </div>

  <div class="content">
    <h2>  Welcome to Staff Dashboard</h2>
   
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>