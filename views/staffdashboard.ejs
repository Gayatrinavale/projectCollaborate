<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin Dashboard</title>

   <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    body {
      margin: 0;
      font-family: 'Arial', sans-serif;
      display: flex;
      height: 100vh;
     background-image: url("/images/black.jpg");
    background-repeat: no-repeat;
    background-size: cover; 
    }

    .sidebar {
      width: 250px;
      background-color: hwb(210 10% 89%);
      color: #a7ecf8;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-top: 20px;
      position: fixed;
      height: 100%;
      overflow-y: auto;
    }

    .sidebar img {
      height: 150px;
      width: 190px;
      border-radius: 8px;
      object-fit: cover;
      margin-bottom: 30px;
      border: none;
    }

    .menu {
      width: 100%;
      display: flex;
      flex-direction: column;
    }

    .menu a,
    .dropdown-toggle {
      display: flex;
      align-items: center;
      padding: 12px 20px;
      color: #d2e4f7;
      text-decoration: none;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 0.3s, transform 0.2s;
    }

    .menu a i,
    .dropdown-toggle i {
      margin-right: 12px;
      font-size: 1.2em;
      color: rgb(185, 222, 238);
    }

    .menu a:hover,
    .dropdown-toggle:hover {
      background-color: #d3d3d3;
      transform: translateX(2px);
    }

    .content {
      margin-left: 250px;
      padding: 90px 30px 30px 30px; /* adjusted for fixed navbar */
      width: calc(100% - 250px);
     background-image: url("/images/black.jpg");
      background-size: cover;
      background-repeat: no-repeat;
      min-height: 100vh;
    }

    .square-box {
      height: 150px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      font-size: 1.2rem;
    }

    @media(max-width: 768px) {
      .sidebar {
        width: 200px;
      }

      .content {
        margin-left: 200px;
        width: calc(100% - 200px);
      }
    }
  </style>
</head>
<body>

  <!-- ✅ Sidebar -->
  <%- include('staffsidebar.ejs') %>

  <!-- ✅ Main Content -->
  <div class="content">
    <!-- ✅ Top Navbar -->
    <%- include('adminNav.ejs') %>

    <!-- ✅ Square Boxes Section -->
    <%- include('square.ejs') %>
  </div>

  <!-- ✅ Bootstrap Bundle JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>