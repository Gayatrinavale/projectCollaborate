<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Moving Image Gallery</title>
<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<!-- Bootstrap 5 CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<!-- Your custom CSS for navbar -->
<link rel="stylesheet" href="/css/navbar.css" />


<style>
  body {
    background-color: #f8f9fa;
    padding: 50px 20px;
    font-family: Arial, sans-serif;
    background-image: url("images/black.jpg");
    background-repeat: no-repeat;
    background-size: cover;
  }

  /* Header styles */
  .big-font {
    font-size: 4rem;
    font-style: oblique;
    text-align: center;
    margin-bottom: 10px;
    color:white;
  }

  .subtitle {
    font-size: 1.9rem;
    text-align: center;
    margin-bottom: 40px;
    color:white;
  }

  /* Container for the moving images */
  .marquee-container {
    overflow: hidden;
    width: 100%;
    max-width: 2000px; /* adjust as needed */
    margin: 0 auto;
    padding-left: 50px; /* Increased left space */
    margin-right: 50px;
  }

  /* Inner wrapper for the images, animated */
  .marquee {
    display: flex;
    width: calc(200px * 50); /* total width of images, adjust accordingly */
    animation: scroll-left 50s linear infinite;
  }

  /* Keyframes for moving left */
  @keyframes scroll-left {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Style for images */
  .img-box {
    flex: 0 0 400px; /* Increased from 200px to 400px */
    margin: 0 10px;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  }

  .img-box img {
    width: 450px; /* match container width or set to 100% for responsiveness */
    height: 450px; /* keep your height consistent or auto for aspect ratio */
    object-fit: cover;
    display: block;
  }
</style>
</head>
<body>
<%- include('nav.ejs') %>
<div class="container text-center">
  <div class="big-font">Gallery</div>
  <div class="subtitle">Check Our Gallery of Tasty Heaven Kitchen</div>
  
  <!-- Moving images -->
  <div class="marquee-container">
    <div class="marquee">
      <!-- Repeat images for seamless loop -->
      <div class="img-box"><img src="images/table.jpg" alt="Image 1" /></div>
      <div class="img-box"><img src="images/chef.jpg" alt="Image 2" /></div>
      <div class="img-box"><img src="images/chef1.jpg" alt="Image 3" /></div>
      <div class="img-box"><img src="images/girlvetar.jpg" alt="Image 4" /></div>
      <div class="img-box"><img src="images/foodie.jpg" alt="Image 5" /></div>
      <div class="img-box"><img src="images/chefgirl.jpg" alt="Image 6" /></div>
      <div class="img-box"><img src="images/girlcook.jpg" alt="Image 8" /></div>
      <div class="img-box"><img src="images/cutefamily.jpg" alt="Image 9" /></div>
     
    </div>
  </div>
</div>

<!-- Bootstrap JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>