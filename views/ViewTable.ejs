<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>View Tables</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Sidebar and Navbar CSS -->
  <link rel="stylesheet" href="/css/adminVertical.css">
  <link rel="stylesheet" href="/css/adminNav.css">
</head>

<style>
  .main-content {
    margin-left: 250px; /* Adjust based on your sidebar width */
    padding: 30px;
    background-color: #f8f9fa;
    min-height: 100vh;
  }

  .table-container {
    background: white;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 0 10px rgba(0,0,0,0.1);
  }

  h2 {
    text-align: center;
    margin-bottom: 25px;
    font-weight: 600;
  }

  .btn-sm {
    margin-right: 5px;
  }
</style>

<body>
  <!-- Include Sidebar -->
  <%- include("adminVertical") %>

  <!-- Include Navbar -->
  <%- include("adminNav") %>

  <div class="main-content">
    <div class="table-container">
      <h2>Dining Tables</h2>

      <% if (typeof msg !== 'undefined') { %>
        <div class="alert alert-info text-center"><%= msg %></div>
      <% } %>

      <table class="table table-bordered table-hover text-center">
        <thead class="table-dark">
          <tr>
            <th>ID</th>
            <th>Capacity</th>
            <th>Availability</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% tables.forEach((table) => { %>
            <tr>
              <td><%= table.table_id %></td>
              <td><%= table.capacity %></td>
              <td><%= table.availability_status %></td>
              <td>
          <a href="/updatetable/<%= table.id %>" class="btn btn-primary btn-sm">Edit</a>
          <a href="/deletetable/<%= table.id %>" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure?')">Delete</a>
        </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
