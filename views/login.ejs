<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Login Form</title>
  <!-- Font Awesome CDN for icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    body {
      margin: 0;
      height: 100vh;
      background-image: url("/images/black.jpg");
      background-size: cover;
      background-repeat: no-repeat;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    form {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(10px);
      border-radius: 25px;
      padding: 40px 40px;
      width: 500px;
      box-shadow: 0 10px 35px rgba(0, 0, 0, 0.25);
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
    }

    .form-header {
      text-align: center;
      margin-bottom: 35px;
    }

    .form-header i {
      font-size: 40px;
      color: #6c63ff;
      margin-bottom: 10px;
    }

    .form-header h2 {
      font-size: 28px;
      color: #333;
      margin: 0;
    }

    .input-group {
      position: relative;
      margin-bottom: 30px;
    }

    .input-group i {
      position: absolute;
      top: 50%;
      left: 18px;
      transform: translateY(-50%);
      color: #444;
      font-size: 20px;
    }

    .control {
      width: 100%;
      height: 55px;
      padding-left: 50px;
      border-radius: 10px;
      border: 1px solid #bbb;
      font-size: 18px;
      box-sizing: border-box;
      transition: 0.3s;
    }

    .control:focus {
      border-color: #6c63ff;
      box-shadow: 0 0 10px rgba(108, 99, 255, 0.3);
      outline: none;
    }

    input[type="submit"] {
      width: 100%;
      height: 55px;
      border-radius: 10px;
      border: none;
      background: linear-gradient(135deg, #6c63ff, #b84ad1);
      color: #fff;
      font-size: 18px;
      font-weight: bold;
      cursor: pointer;
      transition: background 0.3s ease, box-shadow 0.3s ease;
    }

    input[type="submit"]:hover {
      background: linear-gradient(135deg, #5a4bd6, #9e36b8);
      box-shadow: 0 5px 15px rgba(108, 99, 255, 0.4);
    }

    .register-text {
      display: flex;
      justify-content: center;
      align-items: center;
      margin-top: 25px;
      font-size: 18px;
      color: #333;
    }

    .register-text a {
      text-decoration: none;
      margin-left: 8px;
      font-weight: bold;
      color: #6c63ff;
      font-size: 18px;
    }

    .register-text a:hover {
      text-decoration: underline;
    }

    .error-message {
      margin-top: 18px;
      color: red;
      text-align: center;
      font-size: 16px;
    }
  </style>
</head>
<body>

  <form name="ffname" action="/validate" method="post">
    
    <!-- Form Heading -->
    <div class="form-header">
      <i class="fas fa-user-shield"></i>
      <h2>Admin Login</h2>
    </div>

    <!-- Username Field -->
    <div class="input-group">
      <i class="fas fa-user"></i>
      <input type="text" name="username" placeholder="Enter Username" class="control" required />
    </div>

    <!-- Password Field -->
    <div class="input-group">
      <i class="fas fa-lock"></i>
      <input type="password" name="password" placeholder="Enter Password" class="control" required />
    </div>

    <!-- Submit -->
    <input type="submit" name="s" value="Login" />

    <!-- Registration Link -->
    <div class="register-text">
      New Registration? <a href="/signup">Register</a>
    </div>

    <!-- Error Message -->
    <% if (msg) { %>
      <div class="error-message"><%= msg %></div>
    <% } %>
  </form>

</body>
</html>