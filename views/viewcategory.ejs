<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>View Categories</title>
  
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <script type="text/javascript" src="../public/ajax.js"></script>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/adminVertical.css">

  <style>
    body {
      background-image: url("/images/black.jpg");
      background-size: cover;
      background-repeat: no-repeat;
      font-family: 'Segoe UI', sans-serif;
    }

    .main-content {
      margin-left: 350px;
      padding: 20px;
      margin-top: 70px;
    }

    .heading {
      background: linear-gradient(135deg, #4b0082, #ff7e5f);
      color: white;
      padding: 12px 25px;
      border-radius: 10px 10px 0 0;
      font-size: 24px;
      font-weight: bold;
      text-align: center;
      margin-bottom: 10px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    }

    .form-control {
      max-width: 500px;
      margin: 0 auto 20px auto;
    }

    .table-container {
      width: 850px;
      background-color: #fff;
      box-shadow: 0 0 15px rgba(0,0,0,0.2);
      padding: 0;
      border-radius: 10px;
      overflow: hidden;
      margin: auto;
    }

    .table {
      font-size: 15px;
      margin-bottom: 0;
    }

    .table th {
      background-color: #f4f4f4;
      text-align: center;
      font-weight: bold;
    }

    .table td {
      vertical-align: middle;
      text-align: center;
    }

    .no-data-message {
      text-align: center;
      padding: 60px 0;
      font-size: 18px;
      color: #888;
    }

    .action-icons a {
      text-decoration: none;
      font-size: 1.2rem;
      margin: 0 5px;
    }

    .action-icons a.delete {
      color: #f50a45;
    }

    .action-icons a.update {
      margin-right: 5px;
    }

    .action-icons a:hover {
      opacity: 0.7;
    }
  </style>
</head>
<body>

  <%- include('adminVertical.ejs') %>

  <div class="main-content">
    <div class="table-container">
      <div class="heading"><i class="fa-solid fa-list me-2"></i>View Categories</div>

         
        <input type="text" name="sd" class="form-control" placeholder="Search..." onkeyup="ajaxImpl(this.value)">
     

      <table class="table table-striped">
        <thead>
          <tr>
            <th>Id</th>
            <th>Category Name</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="tblBody">
          <% if (data.length === 0) { %>
            <tr>
              <td colspan="3" class="no-data-message">There is no data present in the table</td>
            </tr>
          <% } else {
            for (let i = 0; i < data.length; i++) {
              let item = data[i];
          %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= item.name %></td>
              <td class="action-icons">
                <a href="/delcatbyid?id=<%= item.id %>" class="delete" title="Delete">
                  <i class="fa-solid fa-trash"></i>
                </a>
                <a href="/catupdate?cid=<%= item.id %>" class="update" title="Update">
                  <i class="fa-solid fa-pen-to-square"></i>
                </a>
              </td>
            </tr>
          <% } } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>