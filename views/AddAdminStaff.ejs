<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Add Staff</title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

  <!-- Sidebar & Navbar CSS -->
  <link rel="stylesheet" href="/css/adminVertical.css">
  <link rel="stylesheet" href="/css/adminNav.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" 
  integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <style>
    * {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      padding: 0;
      height: 100%;
      font-family: Arial, sans-serif;
    }

    body {
      background-image: url("/images/black.jpg");
      background-size: cover;
      background-repeat: no-repeat;
      background-position: center;
      display: flex;
    }

    .content-wrapper {
      margin-left: 220px;
      width: calc(100% - 250px);
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      padding: 0 20px;
    }

    .add-staff-card {
      background: white;
      padding: 20px 20px;
      border-radius: 20px;
      box-shadow: 0 0 40px rgba(214, 116, 11, 0.6);
      width: 100%;
      max-width: 450px;
      margin-top: 150px;
      margin-bottom: 90px;
    }

    .add-staff-card h2 {
      text-align: center;
      margin-bottom: 10px;
      font-weight: bold;
      color: #333;
    }

    .add-staff-card label {
      font-weight: 600;
      margin-bottom: 8px;
      display: block;
    }

    .add-staff-card .form-control {
      margin-bottom: 20px;
      height: 40px;
      border-radius: 5px;
    }

    .add-staff-card .btn {
      width: 100%;
      height: 45px;
      font-weight: bold;
      background: linear-gradient(135deg, #4b0082, #ff7e5f);
      border: none;
      color: white;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .add-staff-card .btn:hover {
      transform: scale(1.03);
    }

    @media (max-width: 768px) {
      .content-wrapper {
        margin-left: 0;
        width: 100%;
      }

      .add-staff-card {
        padding: 25px 20px;
      }
    }
  </style>
</head>
<body>

  <!-- Sidebar -->
  <%- include('adminVertical.ejs') %>

  <!-- Navbar -->
  <%- include('adminNav.ejs') %>

  <!-- Page Content -->
  <div class="content-wrapper">
    <div class="add-staff-card">
      <h2><i class="bi bi-person-plus-fill me-2"></i>Add Staff</h2>

      <% if (msg) { %>
        <div class="alert alert-info"><%= msg %><i class="bi bi-emoji-smile ms-2" style="color: red;"></i></div>
      <% } %>

      <form action="/savestaff" method="POST">
        <label>Staff Name</label>
        <input type="text" name="name" class="form-control" required>

        <label>Email</label>
        <input type="email" name="email" class="form-control">

        <label>Contact Number</label>
        <input type="text" name="contact_no" class="form-control">

        <label>Salary</label>
        <input type="number" name="salary" step="0.01" class="form-control">

        <button type="submit" class="btn">Add Staff</button>
      </form>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>