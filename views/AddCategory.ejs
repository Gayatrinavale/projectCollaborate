<body>

  <%- include('adminVertical.ejs') %>
  <%- include('adminNav.ejs') %>

  <div class="container">
    <h2><i class="bi bi-plus-square-dotted me-2"></i>Add Category</h2>
    <form name="fname" action="/save" method="post">
      <div class="form-group">
        <label for="categoryName">Enter the Category</label>
        <input type="text" id="categoryname" name="name" placeholder="Enter CategoryName">
      </div>

      <div class="form-group">
        <input type="submit" value="Add Category">
      </div>

      <% if (msg) { %>
        <div class="alert alert-success text-center mt-3" role="alert">
           <%= msg %> <i class="bi bi-emoji-smile text-success me-2 fs-5"></i>
        </div>
      <% } %>
    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
