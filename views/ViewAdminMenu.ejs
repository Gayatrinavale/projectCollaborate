<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Menu</title>
 <link rel="stylesheet" href="/css/adminVertical.css">
  <link rel="stylesheet" href="/css/adminNav.css">
  <link rel="stylesheet" href="/css/viewmenu.css">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
</head>
<body>
     <!-- Sidebar -->
  <%- include('adminVertical.ejs') %>

  <!-- Navbar -->
  <%- include('adminNav.ejs') %>
<div class="view-menu-container">
  <h2 class="view-menu-title">View Menus</h2>
  <table class="view-menu-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Menu Name</th>
        <th>Category</th>
        <th>Price</th>
        <th>Description</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% menus.forEach((menu) => { %>
        <tr>
          <td><%= menu.id %></td>
          <td><%= menu.name %></td>
          <td><%= menu.category %></td>
          <td>₹<%= menu.price %></td>
          <td><%= menu.description %></td>
          <td class="view-menu-actions">
            <a href="/admin/editmenu/<%= menu.id %>"><i class="fas fa-edit"></i></a>
            <a href="/admin/deletemenu/<%= menu.id %>" onclick="return confirm('Delete this menu?')"><i class="fas fa-trash"></i></a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

</body>
</html>