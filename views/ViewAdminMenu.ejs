<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Menu</title>
 <link rel="stylesheet" href="/css/adminVertical.css">
  <link rel="stylesheet" href="/css/adminNav.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
  <style>
    .main-layout {
  display: flex;
  width: 100%;
}

.adminVertical {  /* If this is your sidebar class */
  width: 300px;
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
}

.content-area {
  margin-left: 300px; /* match the sidebar width */
  width: calc(100% - 300px);
}

.view-menu-container {
  position: relative;
  z-index: 1;
  padding: 100px 20px 20px 20px; /* padding-top gives space for navbar */
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #f8f9fa;
  min-height: 100vh;
}

  </style>
</head>
<body>
  <div class="main-layout d-flex">
    <!-- Sidebar -->
    <%- include('adminVertical.ejs') %>

    <!-- Right Side (Content) -->
    <div class="content-area w-100">
      <!-- Navbar -->
      <%- include('adminNav.ejs') %>

      <!-- Main Content -->
      <div class="view-menu-container">
        <h2 class="view-menu-title">View Menus</h2>
        <table class="view-menu-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Menu Name</th>
              <th>Category</th>
              <th>Price</th>
              <th>Description</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% menus.forEach((menu) => { %>
              <tr>
                <td><%= menu.id %></td>
                <td><%= menu.name %></td>
                <td><%= menu.category %></td>
                <td>₹<%= menu.price %></td>
                <td><%= menu.description %></td>
                <td class="view-menu-actions">
                  <a href="/admin/editmenu/<%= menu.id %>">Edit</a>
                  <a href="/admin/deletemenu/<%= menu.id %>" onclick="return confirm('Delete this menu?')">Delete</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>


</html>