<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>View Staff</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/adminVertical.css">
  <link rel="stylesheet" href="/css/adminNav.css">
  <style>
  .view-staff-page {
    margin-left: 300px;
    margin-top: 60px; /* match your sidebar width */
    padding: 30px;
    background-color: #f8f9fa;
    min-height: 50vh;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  }

  .view-staff-page h2 {
    font-weight: 600;
    margin-bottom: 30px;
    text-align: center;
    color: #343a40;
  }

  .view-staff-table {
    background-color: white;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 1px 10px rgba(0, 0, 0, 0.1);
  }

  .view-staff-table th {
    background-color: #212529;
    color: white;
    text-align: center;
  }

  .view-staff-table td {
    text-align: center;
    vertical-align: middle;
    font-size: 15px;
  }

  .view-staff-alert {
    max-width: 600px;
    margin: 20px auto;
    font-weight: 500;
    text-align: center;
  }
</style>

</head>
<body>
  <!-- Sidebar -->
  <%- include('adminVertical.ejs') %>
  <!-- Navbar -->
  <%- include('adminNav.ejs') %>

  <div class="view-staff-page">
  <h2>Staff Members</h2>

  <% if (msg) { %>
    <div class="alert alert-info view-staff-alert"><%= msg %></div>
  <% } %>

  <table class="table table-striped view-staff-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Email</th>
        <th>Contact No</th>
        <th>Salary</th>
      </tr>
    </thead>
    <tbody>
      <% staffList.forEach(staff => { %>
        <tr>
          <td><%= staff.staff_id %></td>
          <td><%= staff.name %></td>
          <td><%= staff.email %></td>
          <td><%= staff.contact_no %></td>
          <td><%= staff.salary %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>


  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
