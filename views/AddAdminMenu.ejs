<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Add Menu</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Custom Sidebar and Navbar CSS -->
  <link rel="stylesheet" href="/css/adminVertical.css">
  <link rel="stylesheet" href="/css/adminNav.css">
  <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
  <style>
    /* AddMenu styling */
.add-menu-container {
  margin-left: 250px; /* adjust if sidebar width changes */
  padding: 40px 20px;
  background: #eaf9fb;
  min-height: 100vh;
}

.add-menu-card {
  background: white;
  padding: 30px;
  border-radius: 15px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  max-width: 700px;
  margin: auto;
}

.add-menu-card h2 {
  margin-bottom: 25px;
  text-align: center;
  color: #333;
}

.add-menu-card label {
  font-weight: 600;
  margin-bottom: 5px;
  display: block;
}

.add-menu-card .form-control {
  margin-bottom: 20px;
}

.add-menu-card .btn {
  width: 100%;
  font-weight: bold;
}

  </style>
 
</head>
<body>

  <!-- Sidebar -->
  <%- include('adminVertical.ejs') %>

  <!-- Navbar -->
  <%- include('adminNav.ejs') %>

  <div class="add-menu-container">
  <div class="add-menu-card">
    <h2>Add Menu</h2>

    <% if (msg) { %>
      <div class="alert alert-info"><%= msg %></div>
    <% } %>

    <form action="/savemenu" method="POST" enctype="multipart/form-data">
      <label>Menu Name</label>
      <input type="text" name="name" class="form-control" required>

      <select name="category" class="form-control" required>
  <% categories.forEach(cat => { %>
    <option value="<%= cat.id %>"><%= cat.name %></option>
  <% }) %>
</select>


      <label>Price</label>
      <input type="number" name="price" class="form-control" required>

      <label>Description</label>
      <textarea name="description" class="form-control" required></textarea>

      <label>Upload Image</label>
      <input type="file" name="image" class="form-control" accept="image/*" required>

      <button type="submit" class="btn btn-primary">Add Menu</button>
    </form>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
