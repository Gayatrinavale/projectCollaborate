<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>About - Tasty Heaven</title>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<!-- Bootstrap 5 CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<!-- Your custom CSS for navbar -->
<link rel="stylesheet" href="/css/navbar.css" />

<style>
  body {
    margin: 0;
    padding: 0;
    height: 100vh; 
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #f8f9fa;
     background-image: url("images/black.jpg");
      background-repeat: no-repeat;
      background-size: cover;
  }
  
  .footer {
    background-color: #fff;
    padding: 10px;
    border-top: 2px solid #ccc;
    width: 90%; 
    max-width: 1100px;
    box-shadow: 0 0 10px rgba(0,0,0,0.1);
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
    border-radius: 10px;
  }

 
  .footer-inner {
    width: 100%;
    max-width: 1200px; 
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  
  .footer * {
    text-align: center;
  }

  
  .contact-small {
    font-size: 1.2em;
    margin-bottom: 15px;
  }
 
  .need-help {
    font-size: 2.5em;
    font-weight: bold;
    margin-bottom: 40px;
  }
  
  .sections {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    margin-bottom: 40px;
    width: 100%;
  }
 
  .section {
    flex: 1 1 200px;
    max-width: 250px;
    padding: 10px;
  }
 
  .section i {
    font-size: 2.5em;
    color: orange;
    margin-bottom: 15px;
  }
 
  
  .follow-us h2 {
    font-size: 2em;
    
  }
  
  .social-icons {
    margin-top: 5px;
  }
  .social-icons a {
    margin: 0 15px;
    font-size: 2em;
    color: orange;
    text-decoration: none;
  }
 
  .bottom-line {
   
    font-size: 1.5rem;
  }
  
  .copyright {
    margin-top: 10px;
    font-size: 1em;
  }

  .section p{
     font-size: 1.5rem;
  }
</style>
</head>
<body>

 <%- include('nav.ejs') %>

<div class="footer">
  <div class="footer-inner">
    <div class="contact-small">Contact</div>
    <div class="need-help">Need Help ? Contact Us ...</div>
    
    <div class="sections">
     
      <div class="section">
        <i class="fas fa-map-marker-alt"></i>
        <h2>Address</h2>
        <p>Near Kakade City Karvenagar, Pune 412802</p>
      </div>
     
      <div class="section">
        <i class="fas fa-phone"></i>
        <h2>Contact</h2>
        <p>Phone: +91 7654354245<br/>Email: tastyheaven@gmail.com</p>
      </div>
     
      <div class="section">
        <i class="fas fa-clock"></i>
        <h2>Opening Hours</h2>
        <p>Mon-Sat: 11am-11pm<br/>Sunday: 9am-11pm</p>
      </div>
    </div>
    
   
    <div class="follow-us">
      <h2>Follow us</h2>
      <div class="social-icons">
        <a href="#" title="Restaurant"><i class="fas fa-utensils"></i></a>
        <a href="#" title="Facebook"><i class="fab fa-facebook"></i></a>
        <a href="#" title="Instagram"><i class="fab fa-instagram"></i></a>
        <a href="#" title="LinkedIn"><i class="fab fa-linkedin"></i></a>
      </div>
    </div>
    
   
    <div class="bottom-line">
      <p>&copy; Tasty Heaven Kitchen All Rights Reserved</p>
      <p class="copyright">Designed by Gayatri Navale | Distributed by Software Company</p>
    </div>
  </div>
</div>

</body>
</html>