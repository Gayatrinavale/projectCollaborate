<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Our Chefs</title>
  <!-- Bootstrap CSS CDN for layout and card styles -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

  <!-- Bootstrap 5 CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<!-- Your custom CSS for navbar -->
<link rel="stylesheet" href="/css/navbar.css" />

  <style>
    /* Style for the main heading */
    h1.display-3 {
      font-size: 3rem;
      font-weight: bold;
    }

    /* Body background color */
    body {
      background-color: #f8f9fa;
      background-image: url("images/black.jpg");
      background-repeat: no-repeat;
      background-size: cover;
    }

    /* Style for the subtitle */
    .subtitle {
      font-size: 1.5rem;
      margin-bottom: 3rem;
    }

    /* Style for images inside cards to fit properly */
    .card-img-top {
      height: 430px; /* Fixed height for consistency */
      object-fit: cover; /* Ensures image covers the box without distortion */
      width: 100%; /* Full width */
      border-radius: 0.25rem; /* Optional: rounded corners for images */
      border: 1px solid #dee2e6; /* Optional: border around images */
    }

    /* Style for the cards on hover */
    .card:hover {
      transform: translateY(-5px);
      transition: all 0.3s ease;
    }
   .display-3{
      color:white;
    }
    .lead {
      color:white;

    }
  </style>
</head>
<body>

    <%- include('nav.ejs') %>

  <div class="container my-5 text-center">
    <!-- Main Heading -->
    <h1 class="display-3 mb-3">Our Chef</h1>
    <!-- Subtitle -->
    <p class="lead subtitle mb-5">Meet our professional chefs</p>
    <!-- Cards Row -->
    <div class="row justify-content-center">
      <!-- First Chef -->
      <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
          <img src="images/chef.jpg" alt="Sanjeev Kapoor" class="card-img-top" />
          <div class="card-body text-center">
            <h4 class="card-title mb-2">Sanjeev Kapoor</h4>
            <h6 class="text-muted mb-3">Master Chef</h6>
            <p class="card-text">Expert in continental cuisine with 20+ years of experience.</p>
          </div>
        </div>
      </div>
      
      <!-- Second Chef -->
      <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
          <img src="images/chefgirl.jpg" alt="Nidhi Choubey" class="card-img-top" />
          <div class="card-body text-center">
            <h4 class="card-title mb-2">Nidhi Choubey</h4>
            <h6 class="text-muted mb-3">Patissier</h6>
            <p class="card-text">Specialist in pastries and French desserts.</p>
          </div>
        </div>
      </div>
      
      <!-- Third Chef -->
      <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
          <img src="images/chef1.jpg" alt="Vikas Khanna" class="card-img-top" />
          <div class="card-body text-center">
            <h4 class="card-title mb-2">Vikas Khanna</h4>
            <h6 class="text-muted mb-3">Cook</h6>
            <p class="card-text">Loves creating traditional Indian thalis.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>